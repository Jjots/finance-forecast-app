@startuml "Kate dynamic"
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Dynamic — Получение прогноза 

actor "Аналитик" as analyst

' Компоненты внутри web_app (из твоего L3)
Container_Boundary(web_app, "web_app (React)") {
    Component(forecast_page, "Страница прогнозов", "React", "UI")
    Component(forecast_controller, "Контроллер прогнозов", "TypeScript", "Application")
    Component(forecast_service, "Сервис прогнозов", "TypeScript", "Domain")
    Component(cache_repository, "Репозиторий кэша", "IndexedDB", "Data")
    Component(api_repository, "Репозиторий API", "Axios", "Data")
}

' Внешние контейнеры
Container(backend, "Backend API", "FastAPI", "Внешний контейнер")
Container(ml_service, "ML-сервис", "Python", "Внешний контейнер (детали у Дианы)")

' Сценарий (строго по шагам)
Rel(analyst, forecast_page, "1. Выбирает компанию и горизонт", "UI action")
Rel(forecast_page, forecast_controller, "2. Передаёт параметры", "JS call")
Rel(forecast_controller, forecast_service, "3. Запрашивает прогноз", "JS call")
Rel(forecast_service, cache_repository, "4. Проверяет кэш (устарел)", "JS call")
Rel(forecast_service, api_repository, "5. Инициирует запрос на сервер", "JS call")
Rel(api_repository, backend, "6. POST /forecast (JWT)", "HTTPS/JSON/443")

Rel(backend, ml_service, "7. Запрос прогноза", "REST/HTTPS, 8443")

Rel(ml_service, backend, "8. Возвращает рассчитанный прогноз", "REST/HTTPS, 8443")

Rel(backend, api_repository, "9. Возвращает результат", "HTTPS/JSON, 443")

Rel(api_repository, forecast_service, "10. Передаёт полученные данные", "JS call")

Rel(forecast_service, cache_repository, "11. Обновляет кэш прогноза", "JS call")

Rel(forecast_service, forecast_controller, "12. Возвращает прогноз контроллеру", "JS call")

Rel(forecast_controller, forecast_page, "13. Отображает график прогноза", "JS call")

note right of backend
  Ответ возвращается в api_repository,
  а не напрямую в forecast_page.
end note

@enduml