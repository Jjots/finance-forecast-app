@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Deployment: размещение backend и ml_service (проектное решение)

' Клиенты (детализирует Катя)
Deployment_Node(client_devices, "Устройства пользователей", "Браузер / мобильное устройство") {
    Container(web_app, "Веб-приложение", "React + TypeScript", "Интерфейс аналитика, риск-менеджера, администратора")
    Container(mobile_app, "Мобильное приложение", "React Native", "Интерфейс инвестора")
}

' Публичный периметр: единственная входная точка
Deployment_Node(public_zone, "Публичный периметр", "Доступен из интернета только HTTPS 443") {
    Deployment_Node(edge_vm, "Edge VM", "Linux VM") {
        Deployment_Node(edge_docker, "Docker", "Среда контейнеров") {
            Container(nginx, "Nginx", "Nginx", "Edge-прокси: TLS на 443, проксирует API на backend:8000")
        }
    }
}

' Приватная сеть: порты, кроме 443 на edge, закрыты от интернета
Deployment_Node(private_net, "Приватная сеть", "Закрыта от интернета, обмен между узлами с TLS") {

    Deployment_Node(app_vm, "Application VM", "Linux VM") {
        Deployment_Node(app_docker, "Docker", "Отдельные контейнеры") {
            Container(backend, "Backend API", "Python + FastAPI", "Прикладной слой: forecast_comp, data_comp, auth_comp, analytics_comp; адаптеры ml_client_comp, db_repo_comp, ts_repo_comp. Порт 8000")
            Container(scheduler, "Планировщик", "Airflow", "Загрузка данных и запуск переобучения (зона Дани)")
            Container(queue, "Брокер очереди", "RabbitMQ", "Очередь retrain-задач, retry и DLQ предусмотрены (зона Дани). Порт AMQPS 5671")
        }
    }

    Deployment_Node(ml_vm, "ML VM", "Отдельная Linux VM: ресурсоёмкий ML") {
        Deployment_Node(ml_docker, "Docker", "Среда контейнеров") {
            Container(ml_service, "ML Service", "Python, XGBoost, ARIMA", "api_comp (порт 8443), inference_comp, training_comp, task_consumer_comp, model_registry_comp")
        }
    }

    Deployment_Node(db_vm, "Database VM", "Linux VM, закрытая сеть (зона Игоря)") {
        Deployment_Node(db_docker, "Docker", "Среда контейнеров") {
            ContainerDb(db_main, "Основная БД", "PostgreSQL", "Метаданные, пользователи, сохранённые прогнозы. Порт 5432")
            ContainerDb(dwh, "Хранилище временных рядов", "TimescaleDB", "Финансовые ряды. Порт 5433 на хосте, 5432 внутри Docker-сети")
            ContainerDb(db_main_replica, "Реплика db_main", "PostgreSQL", "Проектируемая реплика; не является резервной копией; автопереключение не реализовано")
            ContainerDb(dwh_replica, "Реплика dwh", "TimescaleDB", "Проектируемая реплика; не является резервной копией; автопереключение не реализовано")
        }
    }
}

' Входной трафик
Rel(web_app, nginx, "Запросы API, JWT", "HTTPS / TCP 443")
Rel(mobile_app, nginx, "Запросы API, JWT", "HTTPS / TCP 443")
Rel(nginx, backend, "Проксирует API-запросы клиентов", "HTTP/JSON / TCP 8000, приватная сеть")
Rel(scheduler, nginx, "Передаёт батчи данных в backend.data_comp", "HTTPS/JSON / TCP 443, внутренний адрес")

' Backend / ML
Rel(backend, ml_service, "Запрос прогноза и ответ с прогнозом", "REST/HTTPS / TCP 8443")
Rel(backend, db_main, "Прогнозы, кэш, метаданные", "PostgreSQL SQL/TCP + TLS / 5432")
Rel(backend, dwh, "Запись и чтение финансовых рядов", "PostgreSQL SQL/TCP + TLS / 5433 на хосте, 5432 в Docker-сети")
Rel(ml_service, dwh, "Чтение исторических рядов для обучения и инференса", "PostgreSQL SQL/TCP + TLS / 5433 на хосте, 5432 в Docker-сети")

' Очередь
Rel(scheduler, queue, "Публикует retrain-задачи", "AMQPS (AMQP 0-9-1 + TLS) / TCP 5671")
Rel(ml_service, queue, "Consumer сам подключается и получает retrain-задачи", "AMQPS (AMQP 0-9-1 + TLS) / TCP 5671")

' Проектируемая репликация
Rel(db_main, db_main_replica, "Проектируемая репликация", "репликация БД, приватная сеть")
Rel(dwh, dwh_replica, "Проектируемая репликация", "репликация БД, приватная сеть")

@enduml
