@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Диаграмма компонентов web_app ИС "Финансовый прогноз" (Катя)

' ============================================================
' ВНЕШНИЕ КОНТЕЙНЕРЫ
' ============================================================
Container_Ext(backend, "Backend", "Python + FastAPI", "Бизнес-логика, REST API. Стыковочные компоненты: auth_comp (аутентификация), forecast_comp (прогнозы), data_comp (данные), analytics_comp (аналитика).")

' ============================================================
' WEB_APP: КОМПОНЕНТЫ
' ============================================================
Container_Boundary(web_app, "web_app (React + TypeScript)") {

    Boundary(ui_layer, "Слой представления (UI)") {
        Component(auth_page, "Страница аутентификации", "React", "Формы входа, регистрации и восстановления пароля. Отображает ошибки валидации от контроллера. После успешного входа сохраняет JWT в state и перенаправляет на главную страницу в зависимости от роли (analyst, risk_manager, admin).")
        Component(search_page, "Страница поиска компаний", "React", "Поиск по названию, ИНН и отрасли. Таблица с пагинацией, сортировкой и фильтрами. По клику на строку открывает карточку компании. Поддерживает сохранение последних фильтров в локальном кэше.")
        Component(forecast_page, "Страница прогнозов", "React + Chart.js", "Дашборд с интерактивными графиками прогнозов (Chart.js). Позволяет выбрать горизонт (месяц/квартал/год), сравнить 2-5 компаний, экспортировать отчёт в PDF/Excel. Показывает доверительные интервалы и метрики качества модели.")
        Component(admin_page, "Страница админ-панели", "React", "Управление пользователями и ролями (создание, блокировка, смена роли). Форма загрузки файлов данных (РСБУ/Росстат/ФНС) с валидацией формата. Кнопка запуска переобучения моделей с индикатором прогресса и логом.")
    }

    Boundary(ctrl_layer, "Слой контроллеров (Application)") {
        Component(auth_controller, "Контроллер аутентификации", "TypeScript", "Обрабатывает действия входа/выхода/регистрации от UI. Вызывает auth_service, обрабатывает ошибки, сохраняет JWT в state_manager. Проверяет роль перед вызовом защищённых сервисов (например, admin_controller).")
        Component(forecast_controller, "Контроллер прогнозов", "TypeScript", "Принимает запросы на построение прогноза и сравнение компаний. Валидирует параметры (ID компании, горизонт), вызывает forecast_service. Обрабатывает ошибки backend (404, 500, таймаут) и передаёт их в UI.")
        Component(admin_controller, "Контроллер админ-операций", "TypeScript", "Обрабатывает загрузку файлов, запуск переобучения и управление пользователями. Перед вызовом сервисов проверяет права администратора через auth_service. Логирует все админ-действия.")
    }

    Boundary(service_layer, "Слой сервисов (Domain)") {
        Component(auth_service, "Сервис аутентификации", "TypeScript", "Логика аутентификации: отправка credentials на backend (auth_comp), получение и валидация JWT, хранение токена в cache_repository. Разграничение доступа по ролям: метод hasRole(role) для проверки прав в контроллерах.")
        Component(forecast_service, "Сервис прогнозов", "TypeScript", "Бизнес-логика прогнозов: запрос к backend (forecast_comp), кэширование результатов на 15 минут, форматирование данных для Chart.js (массивы точек, метки времени). При недоступности backend возвращает последний кэшированный прогноз.")
        Component(export_service, "Сервис экспорта", "SheetJS + jsPDF", "Формирование отчётов: выгрузка таблиц в Excel (SheetJS) и графиков в PDF (jsPDF). Читает данные из cache_repository. Поддерживает шаблоны отчётов для аналитика и риск-менеджера.")
        Component(validation_service, "Сервис валидации", "TypeScript + Zod", "Валидация форм и входных данных: email, пароль, ИНН, горизонт прогноза. Использует схемы Zod. Возвращает структурированные ошибки для отображения в UI.")
    }

    Boundary(data_layer, "Слой доступа к данным (Data)") {
        Component(api_repository, "Репозиторий API", "Axios", "Единая обёртка над REST API backend. Автоматически добавляет JWT в заголовок Authorization. Обрабатывает ошибки (401 → logout, 500 → retry), таймауты (10 сек), retry-логику (3 попытки с экспоненциальной задержкой).")
        Component(cache_repository, "Репозиторий кэша", "LocalStorage / IndexedDB", "Кэширование прогнозов, настроек и сессии. LocalStorage — для небольших данных (токен, настройки), IndexedDB — для прогнозов и графиков. TTL кэша: 15 минут для прогнозов, 24 часа для справочников.")
    }
}

' ============================================================
' ПРЕДСТАВЛЕНИЕ -> КОНТРОЛЛЕРЫ
' ============================================================
Rel(auth_page, auth_controller, "Вызывает действия входа/выхода/регистрации", "JS call")
Rel(search_page, forecast_controller, "Отправляет запрос на поиск компаний", "JS call")
Rel(forecast_page, forecast_controller, "Запрашивает прогноз и сравнение", "JS call")
Rel(admin_page, admin_controller, "Вызывает админ-операции (загрузка, переобучение)", "JS call")

' ============================================================
' КОНТРОЛЛЕРЫ -> СЕРВИСЫ
' ============================================================
Rel(auth_controller, auth_service, "Делегирует логику аутентификации", "JS call")
Rel(forecast_controller, forecast_service, "Делегирует логику прогнозов", "JS call")
Rel(admin_controller, auth_service, "Проверяет права администратора", "JS call")
Rel(forecast_page, export_service, "Экспортирует отчёт в PDF/Excel", "JS call")
Rel(search_page, validation_service, "Валидирует форму поиска", "JS call")

' ============================================================
' СЕРВИСЫ -> РЕПОЗИТОРИИ
' ============================================================
Rel(auth_service, api_repository, "Запрашивает аутентификацию (auth_comp)", "JS call")
Rel(forecast_service, api_repository, "Запрашивает прогнозы (forecast_comp)", "JS call")
Rel(forecast_service, cache_repository, "Кэширует прогнозы", "JS call")
Rel(export_service, cache_repository, "Читает данные для экспорта", "JS call")
Rel(auth_service, cache_repository, "Сохраняет сессию и JWT", "JS call")

' ============================================================
' РЕПОЗИТОРИИ -> ВНЕШНИЕ КОНТЕЙНЕРЫ
' ============================================================
Rel(api_repository, backend, "REST-запросы: auth_comp, forecast_comp, data_comp, analytics_comp", "HTTPS/JSON")

@enduml