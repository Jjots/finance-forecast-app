@startuml "Finance Forecast - Igor L3 TimescaleDB"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title L3 — Компоненты хранилища временных рядов dwh (TimescaleDB)

Container_Ext(backend, "Backend", "Python + FastAPI", "Аналитические запросы и запись данных.")
Container_Ext(ml_service, "ML-сервис", "Python + scikit-learn / XGBoost", "Чтение данных для обучения и прогноза.")

Container_Boundary(dwh, "dwh — TimescaleDB: hypertables, агрегаты и политики хранения") {

    Boundary(storage_layer, "Слой хранения временных рядов") {
        Component(dwh_hypertable_comp, "Hypertable Storage", "TimescaleDB hypertables", "Хранение временных рядов с разбивкой по времени.")
    }

    Boundary(access_layer, "Слой доступа к данным") {
        Component(dwh_ingest_comp, "Ingest Service", "SQL / TimescaleDB API", "Приём данных от backend и вставка в hypertables.")
        Component(dwh_query_comp, "Query Service", "SQL / TimescaleDB API", "Аналитические запросы: агрегации, срезы, поиск по времени.")
    }

    Boundary(maintenance_layer, "Слой обслуживания") {
        Component(dwh_retention_comp, "Retention Policy", "TimescaleDB policies", "Политики хранения — удаление и архивация старых данных.")
        Component(dwh_continuous_agg_comp, "Continuous Aggregates", "TimescaleDB materialized views", "Материализованные представления для быстрых агрегатов.")
    }
}

Rel(backend, dwh_ingest_comp, "Запись данных", "SQL/TCP")
Rel(backend, dwh_query_comp, "Аналитические запросы", "SQL/TCP")
Rel(ml_service, dwh_query_comp, "Чтение данных для обучения", "SQL/TCP")

Rel(dwh_ingest_comp, dwh_hypertable_comp, "Вставка в hypertable", "SQL/Insert")
Rel(dwh_query_comp, dwh_hypertable_comp, "Чтение из hypertable", "SQL/Select")
Rel(dwh_query_comp, dwh_continuous_agg_comp, "Запрос агрегатов", "SQL/Select")
Rel(dwh_continuous_agg_comp, dwh_hypertable_comp, "Чтение для агрегатов", "SQL/Select")
Rel(dwh_retention_comp, dwh_hypertable_comp, "Удаление старых данных", "SQL/Delete")

@enduml