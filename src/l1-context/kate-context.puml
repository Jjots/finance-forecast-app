@startuml "Finance Forecast - Kate L1 Context"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title L1 — Контекст: фокус на клиентские приложения (Катя)

' ============================================================
' ПЕРСОНЫ
' ============================================================
Person(analyst, "Аналитик", "Финансовый специалист. Ищет компании, строит прогнозы, экспортирует отчёты. Работает через веб-приложение.")
Person(investor, "Инвестор", "Просматривает прогнозы, сравнивает компании, получает рекомендации. Работает через мобильное приложение.")
Person(risk_manager, "Риск-менеджер", "Оценивает волатильность, проверяет качество моделей. Работает через веб-приложение.")
Person(admin, "Администратор", "Управляет пользователями, загружает данные, запускает переобучение. Работает через веб-приложение в админ-режиме.")

' ============================================================
' ЦЕНТРАЛЬНЫЙ БЛОК — СИСТЕМА
' ============================================================
System(finance_forecast_system, "Finance Forecast System", "Приложение для анализа и прогнозирования финансовых показателей российских компаний с использованием ML. Точки входа: web_app (React + TypeScript) и mobile_app (React Native).")

' ============================================================
' ВНЕШНИЕ СИСТЕМЫ — ИСТОЧНИКИ ДАННЫХ
' ============================================================
System_Ext(rfsd_dataset, "РСБУ (ИПП)", "Финансовая отчётность российских компаний 2011-2025. Формат Parquet.")
System_Ext(cbr_api, "ЦБ РФ", "Ключевая ставка, курсы валют, макроэкономические показатели.")
System_Ext(moex_api, "Московская биржа", "Котировки, индексы, торговая статистика.")

' ============================================================
' СВЯЗИ: ПОЛЬЗОВАТЕЛИ → СИСТЕМА (ФОКУС)
' ============================================================

' --- Веб-приложение: аналитик, риск-менеджер, админ ---
Rel(analyst, finance_forecast_system, "Анализирует компании, строит прогнозы, экспортирует отчёты (через web_app)", "HTTPS")
Rel(risk_manager, finance_forecast_system, "Проверяет модели, оценивает волатильность (через web_app)", "HTTPS")
Rel(admin, finance_forecast_system, "Управляет пользователями, загружает данные, запускает переобучение (через web_app)", "HTTPS")

' --- Мобильное приложение: инвестор ---
Rel(investor, finance_forecast_system, "Просматривает прогнозы, сравнивает компании (через mobile_app)", "HTTPS")

' ============================================================
' СВЯЗИ: СИСТЕМА → ВНЕШНИЕ ИСТОЧНИКИ
' ============================================================
Rel(finance_forecast_system, rfsd_dataset, "Загружает финансовую отчётность", "HTTPS/File")
Rel(finance_forecast_system, cbr_api, "Загружает макроэкономические данные", "REST/HTTPS")
Rel(finance_forecast_system, moex_api, "Загружает котировки и индексы", "REST/HTTPS")

@enduml