@startuml "Finance Forecast - System Context"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title Диаграмма системного контекста ИС "Финансовый прогноз"

' ============================================================
' ПЕРСОНЫ
' ============================================================
Person(analyst, "Аналитик", "Финансовый специалист. Ищет компании, строит прогнозы, экспортирует отчёты.")
Person(investor, "Инвестор", "Просматривает прогнозы, сравнивает компании, получает рекомендации.")
Person(risk_manager, "Риск-менеджер", "Оценивает волатильность, проверяет качество моделей.")
Person(admin, "Администратор", "Управляет пользователями, загружает данные, запускает переобучение.")

' ============================================================
' ЦЕНТРАЛЬНЫЙ БЛОК 
' ============================================================
System(finance_forecast_system, "Finance Forecast System", "Приложение для анализа и прогнозирования финансовых показателей российских компаний с использованием ML.")

' ============================================================
' ВНЕШНИЕ СИСТЕМЫ 
' ============================================================
System_Ext(rfsd_dataset, "РСБУ (ИПП)", "Финансовая отчётность российских компаний 2011-2025. Формат Parquet.")
System_Ext(cbr_api, "ЦБ РФ", "Ключевая ставка, курсы валют, макроэкономические показатели.")
System_Ext(moex_api, "Московская биржа", "Котировки, индексы, торговая статистика.")

' ============================================================
' СВЯЗИ 
' ============================================================

' Персоны → Система
Rel(analyst, finance_forecast_system, "Использует: анализ и прогнозирование", "HTTPS")
Rel(investor, finance_forecast_system, "Просматривает прогнозы и рекомендации", "HTTPS")
Rel(risk_manager, finance_forecast_system, "Проверяет качество моделей и риски", "HTTPS")
Rel(admin, finance_forecast_system, "Управляет системой и загружает данные", "HTTPS")

' Система → Внешние источники
Rel(finance_forecast_system, rfsd_dataset, "Загружает финансовую отчётность", "HTTPS/File")
Rel(finance_forecast_system, cbr_api, "Загружает макроэкономические данные", "REST/HTTPS")
Rel(finance_forecast_system, moex_api, "Загружает котировки и индексы", "REST/HTTPS")

@enduml