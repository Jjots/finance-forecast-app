@startuml
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров backend ИС "Финансовый прогноз"

Container(web_app, "Веб-приложение", "React + TypeScript", "Клиент аналитика, риск-менеджера и администратора.")
Container(mobile_app, "Мобильное приложение", "React Native", "Клиент инвестора.")

System_Boundary(backend_boundary, "Backend") {
    Container(api_backend, "Backend API", "Python + FastAPI", "Бизнес-логика, нормализация данных, оркестрация.")
}

Container(ml_service, "ML-сервис", "Python + scikit-learn / XGBoost", "Обучение моделей (XGBoost, ARIMA) и инференс прогнозов.")
ContainerDb(db_main, "Основная БД", "PostgreSQL", "Пользователи, компании, настройки, метаданные моделей.")
ContainerDb(dwh, "Хранилище временных рядов", "TimescaleDB", "Исторические финансовые показатели, котировки, макроэкономика.")

Rel(web_app, backend, "Запросы", "HTTPS/JSON")
Rel(mobile_app, backend, "Запросы", "HTTPS/JSON")
Rel(api_backend, ml_service, "Запрос прогноза", "REST/gRPC")
Rel(api_backend, db_main, "Чтение/запись", "SQL/TCP")
Rel(api_backend, dwh, "Аналитические запросы", "SQL/TCP")

@enduml
