@startuml "Finance Forecast - Kate L2 Containers"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title L2 — Контейнеры: фокус на web_app и mobile_app (Катя, бизнес-аналитик + UI/UX)

' ============================================================
' АКТОРЫ — С ТОЧКАМИ ВХОДА И БИЗНЕС-ЦЕЛЯМИ
' ============================================================
Person(analyst, "Аналитик", "Финансовый специалист. Цель: найти компании, построить прогноз, экспортировать отчёт. Точка входа: web_app (десктоп).")
Person(investor, "Инвестор", "Частный инвестор. Цель: быстро посмотреть прогноз, сравнить компании, получить рекомендацию. Точка входа: mobile_app.")
Person(risk_manager, "Риск-менеджер", "Оценивает волатильность. Цель: проверить качество моделей, увидеть метрики. Точка входа: web_app (десктоп).")
Person(admin, "Администратор", "Управляет системой. Цель: управлять пользователями, загружать данные, запускать переобучение. Точка входа: web_app (админ-режим).")

' ============================================================
' ВНЕШНИЕ СИСТЕМЫ (источники данных)
' ============================================================
System_Ext(rfsd_dataset, "РСБУ (ИПП)", "Финансовая отчётность российских компаний 2011-2025. Parquet.")
System_Ext(cbr_api, "ЦБ РФ", "Ключевая ставка, курсы валют, макроэкономика.")
System_Ext(moex_api, "Московская биржа", "Котировки, индексы, торговая статистика.")

' ============================================================
' ГРАНИЦА СИСТЕМЫ
' ============================================================
System_Boundary(finance_system, "Finance Forecast System") {

    ' --- КАТЯ: КЛИЕНТСКИЕ ПРИЛОЖЕНИЯ (ФОКУС UI/UX) ---

    Container(web_app, "Веб-приложение", "React + TypeScript", "Основной интерфейс для аналитика, риск-менеджера и админа. Ключевые экраны: поиск и карточка компании, дашборд с графиками прогнозов, сравнение компаний, экспорт отчётов, админ-панель (пользователи, загрузка данных, запуск переобучения). UX-принципы: быстрый поиск, наглядные графики, экспорт в 1 клик.")
    Container(mobile_app, "Мобильное приложение", "React Native", "Интерфейс инвестора. Ключевые экраны: лента прогнозов, карточка компании, сравнение 2-3 компаний, рекомендации, push-уведомления. UX-принципы: минимум действий до прогноза, крупные графики, офлайн-кэш последних прогнозов.")

    ' --- ДИАНА: бэкенд ---
    Container(backend, "Backend", "Python + FastAPI", "Бизнес-логика, нормализация данных, оркестрация, REST API для клиентов.")

    ' --- АЛИСА: ML-сервис ---
    Container(ml_service, "ML-сервис", "Python + scikit-learn / XGBoost", "Обучение моделей (XGBoost, ARIMA) и инференс прогнозов.")

    ' --- ИГОРЬ: хранилища ---
    ContainerDb(db_main, "Основная БД", "PostgreSQL", "Пользователи, компании, настройки, метаданные моделей.")
    ContainerDb(dwh, "Хранилище временных рядов", "TimescaleDB", "Исторические финансовые показатели, котировки, макроэкономика.")

    ' --- ДАНЯ: инфраструктура ---
    Container(queue, "Брокер сообщений", "RabbitMQ", "Асинхронные задачи: загрузка данных, запуск ML-задач.")
    Container(scheduler, "Планировщик", "Airflow / Celery Beat", "Регулярная загрузка данных и переобучение раз в неделю.")
}

' ============================================================
' СВЯЗИ — ФОКУС НА КЛИЕНТСКИХ ПРИЛОЖЕНИЯХ И UX-СЦЕНАРИЯХ
' ============================================================

' --- Пользователи → клиенты (ФОКУС: точки входа и сценарии) ---
Rel(analyst, web_app, "Сценарий: поиск компании → карточка → прогноз → экспорт отчёта", "HTTPS")
Rel(risk_manager, web_app, "Сценарий: выбор модели → метрики → оценка волатильности", "HTTPS")
Rel(admin, web_app, "Сценарий: управление пользователями, загрузка данных, запуск переобучения", "HTTPS")
Rel(investor, mobile_app, "Сценарий: лента прогнозов → карточка → сравнение → рекомендация", "HTTPS")

' --- Клиенты → backend (ФОКУС: REST-контракты) ---
Rel(web_app, backend, "REST-запросы: поиск, прогнозы, графики, экспорт, админ-операции", "HTTPS/JSON")
Rel(mobile_app, backend, "REST-запросы: лента, прогнозы, сравнение, рекомендации, push-токены", "HTTPS/JSON")

' --- Backend → ML ---
Rel(backend, ml_service, "Запрос прогноза", "REST/gRPC")

' --- Backend → БД ---
Rel(backend, db_main, "Чтение / запись: пользователи, настройки, сессии", "SQL/TCP")
Rel(backend, dwh, "Аналитические запросы: временные ряды, метрики", "SQL/TCP")

' --- ML → DWH ---
Rel(ml_service, dwh, "Загрузка данных для обучения", "SQL/TCP")

' --- Scheduler → внешние источники ---
Rel(scheduler, rfsd_dataset, "Загрузка датасета", "HTTPS/File")
Rel(scheduler, cbr_api, "Загрузка макроэкономики", "REST/HTTPS")
Rel(scheduler, moex_api, "Загрузка котировок", "REST/HTTPS")

' --- Scheduler → очередь ---
Rel(scheduler, queue, "Публикация задач", "AMQP")

' --- Очередь → ML ---
Rel(queue, ml_service, "Передача задач на переобучение", "AMQP")

@enduml